                      {
                        "uuid": "ef99e041-9042-44e3-a8ea-74996a0b2aed",
                        "type": "Group",
                        "userData": {
                          "oid": "o57",
                          "custom": true,
                          "icon": "🟠",
                          "displayName": "Switch: Envelope",
                          "behaviorDesc": "Click toggle for viral envelope on/off; rewrites the virus controller and rebuilds the central model.",
                          "builderCode": "\nconst g=T.group();\nconst base=T.mesh(new THREE.CylinderGeometry(0.55,0.6,0.35,24), T.mat('#c05621',{roughness:0.5}));\ng.add(base);\nconst ball=T.mesh(new THREE.SphereGeometry(0.32,20,20), T.mat('#ff9d5c',{roughness:0.4,transparent:true,opacity:0.6}));\nball.position.y=0.45; g.add(ball);\ng.userData.customUpdate=(dt,t)=>{ const on=window.__virusCtl&&window.__virusCtl.userData.state.envelope; ball.material.opacity=on?0.85:0.2; };\nT.attachLabel(g,{title:'ENVELOPE',accent:'#ff9d5c',width:2.4,lines:['Click to toggle','YES / NO']});\ng.userData.customClick=()=>{\n  const ctl=window.__virusCtl; if(!ctl) return;\n  const s=ctl.userData.state; s.envelope=!s.envelope;\n  ctl.userData.rebuild(); T.toast('Envelope → '+(s.envelope?'YES':'NO'));\n};\nreturn g;\n"
                        },
