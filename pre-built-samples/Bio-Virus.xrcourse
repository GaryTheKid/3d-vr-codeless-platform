                                "title": "Capsid = the protein coat",
                                "lines": [
                                  {
                                    "k": "Capsid",
                                    "v": "protein shell around the nucleic acid"
                                  },
                                  {
                                    "k": "It protects",
                                    "v": "the DNA or RNA core"
                                  },
                                  {
                                    "k": "Shape is a TRAIT",
                                    "v": "1 of 3 classification switches"
                                  },
                                  {
                                    "k": "The 3 switches",
                                    "v": "capsid shape + envelope + DNA/RNA"
                                  },
                                  {
                                    "k": "Click each model",
                                    "v": "to explore shape & example"
                                  }
                                ],
