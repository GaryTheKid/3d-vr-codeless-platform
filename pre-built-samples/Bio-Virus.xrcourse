          "id": "ch_msgqjc7dboo7",
          "title": "Check Your Understanding",
          "summary": "Verify mastery of virus structure, host dependence, the alive debate, and trait-based classification.",
          "sections": [
            {
              "id": "sec_msgqjc7ddeyf",
              "title": "Virus Mastery Quiz",
              "type": "quiz",
              "summary": "True/False and Short Answer items at the end of Lesson 1, plus the classification table.",
              "purpose": "Test true/false and classification reasoning across all key nodes and confirm the aha keys took hold.",
              "vr": {},
              "reading": {
                "chunks": []
              },
              "h5": {
                "prompt": "",
                "html": "",
                "status": "idle",
                "followUp": null
              },
              "quiz": {
                "items": [
                  {
                    "id": "q_msgqkp3wqyaz",
                    "type": "mcq",
                    "question": "A newly discovered microbe is found floating in pond water. Scientists note it has genetic material and a protein coat, but no membrane, no cytoplasm, and no ribosomes. When placed alone in a nutrient-rich dish, it never makes copies of itself — but inside an amoeba, copies appear. Why can't it reproduce alone?",
                    "options": [
                      "It needs more nutrients in the dish",
                      "It is not a cell and lacks the machinery to make proteins, so it must hijack a host cell",
                      "It was too cold in the dish",
                      "Its protein coat blocks reproduction until it warms up"
                    ],
                    "answer": "1",
                    "explanation": "aha1: A virus is only genetic material inside a coat. Without ribosomes and cell machinery it cannot make proteins or copy itself, so it must use a host cell — exactly what happened inside the amoeba."
                  },
                  {
                    "id": "q_msgqkp3whcvj",
                    "type": "short",
                    "question": "A classmate argues: 'The pond microbe above evolves and carries genes, so it is definitely alive. Case closed.' Explain why this is NOT a simple yes/no answer, citing one trait that supports 'alive' and one that supports 'not alive.'",
                    "options": [
                      "",
                      "",
                      "",
                      ""
                    ],
                    "answer": "borderline",
                    "explanation": "aha2: It shares living traits (has genetic material, can evolve) but lacks cell structure and cannot self-reproduce. Because it sits on the border of life, whether it's 'alive' is a genuine judgment call, not an obvious yes."
                  },
                  {
                    "id": "q_msgqkp3wilrr",
                    "type": "mcq",
                    "question": "A scientist studies an unknown virus that causes a livestock illness. Lab results: capsid is helical, an envelope is present, and its nucleic acid is RNA. Using the three-trait system, which known family does it match?",
                    "options": [
                      "Adenovirus (icosahedral, no envelope, DNA)",
                      "Herpes (icosahedral, enveloped, DNA)",
                      "Orthomyxovirus (helical, enveloped, RNA)",
                      "Coronavirus (complex, enveloped, RNA)"
                    ],
                    "answer": "2",
                    "explanation": "aha3: Read the three independent switches — helical + enveloped + RNA matches the Orthomyxovirus family (flu). You decode the family from traits rather than memorizing names."
                  },
                  {
                    "id": "q_msgqkp3wn1ms",
                    "type": "mcq",
                    "question": "Two viruses cause different diseases in fish. Virus A: icosahedral, no envelope, DNA. Virus B: icosahedral, enveloped, DNA. Both have the same capsid shape and same nucleic acid. What single switch separates them into different families?",
                    "options": [
                      "Their disease symptoms",
                      "The presence or absence of an envelope",
                      "Their size",
                      "Whether they can evolve"
                    ],
                    "answer": "1",
                    "explanation": "aha3: Capsid shape and nucleic acid are identical, so the deciding independent trait is the envelope (like Adenovirus vs Herpes). Each trait is a separate dial."
                  },
                  {
                    "id": "q_msgqkp3w3eia",
                    "type": "short",
                    "question": "True or False, and explain: 'A virion is smaller than a eukaryotic cell but larger than a prokaryotic cell.'",
                    "options": [
                      "",
                      "",
                      "",
                      ""
                    ],
                    "answer": "false",
                    "explanation": "n1: False. A virion is a tiny particle much smaller than a prokaryotic cell, not larger."
                  }
                ]
              },
