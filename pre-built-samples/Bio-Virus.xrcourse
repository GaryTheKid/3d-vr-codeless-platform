                      {
                        "uuid": "754a90c7-846c-4c68-8f14-7c64bac102b0",
                        "type": "Group",
                        "userData": {
                          "oid": "o58",
                          "custom": true,
                          "icon": "🧬",
                          "displayName": "Switch: Nucleic Acid",
                          "behaviorDesc": "Click toggle DNA↔RNA (a virus has one, never both); rewrites the virus controller and rebuilds the central model.",
                          "builderCode": "\nconst g=T.group();\nconst base=T.mesh(new THREE.CylinderGeometry(0.55,0.6,0.35,24), T.mat('#6b46c1',{roughness:0.5}));\ng.add(base);\nconst helix=T.group(); helix.position.y=0.45; g.add(helix);\nfor(let i=0;i<10;i++){\n  const t=i/9; const b=T.mesh(new THREE.SphereGeometry(0.07,8,8), T.mat('#ffd23f',{roughness:0.4}));\n  b.position.set(Math.cos(t*6)*0.18, (t-0.5)*0.5, Math.sin(t*6)*0.18); helix.add(b);\n}\ng.userData.helix=helix;\ng.userData.customUpdate=(dt,t)=>{ helix.rotation.y=t*1.5;\n  const acid=window.__virusCtl&&window.__virusCtl.userData.state.acid;\n  helix.children.forEach(c=>c.material.color.set(acid==='RNA'?'#ff6ec7':'#ffd23f'));\n};\nT.attachLabel(g,{title:'NUCLEIC ACID',accent:'#b794f4',width:2.4,lines:['Click to toggle','DNA / RNA (never both)']});\ng.userData.customClick=()=>{\n  const ctl=window.__virusCtl; if(!ctl) return;\n  const s=ctl.userData.state; s.acid = s.acid==='DNA'?'RNA':'DNA';\n  ctl.userData.rebuild(); T.toast('Nucleic acid → '+s.acid);\n};\nreturn g;\n",
                          "helix": {
                            "metadata": {
                              "version": 4.6,
                              "type": "Object",
                              "generator": "Object3D.toJSON"
                            },
                            "geometries": [
                              {
                                "uuid": "b80a5e5b-144c-4e2b-ae78-5bb2c82c3779",
                                "type": "SphereGeometry",
                                "radius": 0.07,
                                "widthSegments": 8,
                                "heightSegments": 8,
                                "phiStart": 0,
                                "phiLength": 6.283185307179586,
                                "thetaStart": 0,
                                "thetaLength": 3.141592653589793
                              },
                              {
                                "uuid": "fa461797-1b7b-4501-92ed-c3e5101bc476",
                                "type": "SphereGeometry",
                                "radius": 0.07,
                                "widthSegments": 8,
