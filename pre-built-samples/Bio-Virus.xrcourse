                      {
                        "uuid": "d3196be3-6616-43b8-b16e-42daeb858d56",
                        "type": "Group",
                        "userData": {
                          "spin": 0.4,
                          "oid": "o49",
                          "custom": true,
                          "icon": "🧬",
                          "displayName": "Helical Capsid",
                          "behaviorDesc": "Helical capsid model: protein subunits coiled in a spiral tube around an RNA strand. Click to highlight and show example (Orthomyxo / Flu). Spins slowly.",
                          "builderCode": "const g=T.group();\n// central RNA strand\nconst rna=T.mesh(new THREE.TorusKnotGeometry(0.06,0.02,80,8,3,7),T.mat('#ffd23f',{emissive:'#5a4a00',roughness:0.4}));\n// build helical protein subunits along a vertical axis\nconst cap=T.mat('#3a7bd5',{roughness:0.5});\nconst turns=5, per=12, R=0.45, H=2.2;\nfor(let i=0;i<turns*per;i++){\n  const a=i/per*Math.PI*2; const y=-H/2 + H*(i/(turns*per));\n  const b=T.mesh(new THREE.SphereGeometry(0.13,10,10),cap);\n  b.position.set(Math.cos(a)*R, y, Math.sin(a)*R);\n  g.add(b);\n}\n// inner rna helix\nfor(let i=0;i<turns*per;i++){\n  const a=i/per*Math.PI*2+0.5; const y=-H/2 + H*(i/(turns*per));\n  const b=T.mesh(new THREE.SphereGeometry(0.05,6,6),T.mat('#ffd23f',{emissive:'#5a4a00'}));\n  b.position.set(Math.cos(a)*0.18, y, Math.sin(a)*0.18);\n  g.add(b);\n}\ng.userData.spin=0.4;\ng.userData.customUpdate=(dt,t,o)=>{o.rotation.y+=dt*o.userData.spin;};\ng.userData.customClick=(o)=>{o.userData.spin = o.userData.spin>0?0:0.4; T.toast(o.userData.spin?'Helical spinning':'HELICAL: rod-shaped, protein subunits spiral around RNA. Example: Orthomyxo / Flu');};\nreturn g;"
                        },
