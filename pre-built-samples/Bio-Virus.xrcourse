                      {
                        "uuid": "033288bf-36f0-4eb2-a3ac-b8f51257031f",
                        "type": "Group",
                        "userData": {
                          "oid": "o56",
                          "custom": true,
                          "icon": "🔺",
                          "displayName": "Switch: Capsid Shape",
                          "behaviorDesc": "Click toggle cycling capsid shape helical→icosahedral→complex; rewrites the virus controller and rebuilds the central model.",
                          "builderCode": "\nconst g=T.group();\nconst base=T.mesh(new THREE.CylinderGeometry(0.55,0.6,0.35,24), T.mat('#2b6cb0',{roughness:0.5}));\ng.add(base);\nconst knob=T.mesh(new THREE.ConeGeometry(0.32,0.5,4), T.mat('#4a9eff',{roughness:0.4,emissive:'#123',flatShading:true}));\nknob.position.y=0.42; g.add(knob);\ng.userData.customUpdate=(dt,t)=>{ knob.rotation.y=t*1.2; };\nT.attachLabel(g,{title:'CAPSID SHAPE',accent:'#4a9eff',width:2.6,lines:['Click to cycle','helical / icosa / complex']});\ng.userData.customClick=()=>{\n  const ctl=window.__virusCtl; if(!ctl) return;\n  const order=['helical','icosahedral','complex'];\n  const s=ctl.userData.state; s.shape=order[(order.indexOf(s.shape)+1)%3];\n  ctl.userData.rebuild(); T.toast('Capsid → '+s.shape);\n};\nreturn g;\n"
                        },
