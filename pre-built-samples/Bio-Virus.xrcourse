                      {
                        "uuid": "b7eb69db-abe7-4605-9db5-914e28d05d12",
                        "type": "Group",
                        "userData": {
                          "state": {
                            "shape": "icosahedral",
                            "envelope": false,
                            "acid": "DNA"
                          },
                          "table": [
                            {
                              "fam": "Adenovirus",
                              "shape": "icosahedral",
                              "envelope": false,
                              "acid": "DNA",
                              "dis": "Acute respiratory disease"
                            },
                            {
                              "fam": "Herpes Viruses",
                              "shape": "icosahedral",
                              "envelope": true,
                              "acid": "DNA",
                              "dis": "Chicken Pox"
                            },
                            {
                              "fam": "Orthomyxo Viruses",
                              "shape": "helical",
                              "envelope": true,
                              "acid": "RNA",
                              "dis": "Influenza (Flu)"
                            },
                            {
                              "fam": "Coronaviruses",
                              "shape": "complex",
                              "envelope": true,
                              "acid": "RNA",
                              "dis": "Common cold"
                            }
                          ],
                          "oid": "o55",
                          "custom": true,
                          "icon": "🦠",
                          "displayName": "Build-a-Virus Machine",
                          "behaviorDesc": "Central virion model that rebuilds live from 3 switches (capsid shape / envelope / nucleic acid). Reads a shared controller's userData; names the family when traits match a table row.",
                          "builderCode": "\nconst g = T.group();\n// shared controller state (other switch objects read/write this)\ng.userData.state = { shape:'icosahedral', envelope:false, acid:'DNA' };\nwindow.__virusCtl = g; // simple shared handle\n\nconst holder = T.group(); g.add(holder);\ng.userData.holder = holder;\n\n// nucleic acid core (always present) - color by DNA/RNA\nconst core = T.mesh(new THREE.SphereGeometry(0.28,20,20), T.mat('#ffd23f',{emissive:'#7a5a00',roughness:0.4}));\ng.userData.core = core;\n\nfunction buildCapsid(shape){\n  const grp = T.group();\n  if(shape==='helical'){\n    const col='#4a9eff';\n    for(let i=0;i<14;i++){\n      const t=i/13;\n      const ring=T.mesh(new THREE.TorusGeometry(0.4,0.09,10,20), T.mat(col,{roughness:0.5,transparent:true,opacity:0.85}));\n      ring.rotation.x=Math.PI/2; ring.position.y=(t-0.5)*1.3;\n      grp.add(ring);\n    }\n  } else if(shape==='icosahedral'){\n    const cap=T.mesh(new THREE.IcosahedronGeometry(0.72,0), T.mat('#9aa0a6',{roughness:0.6,transparent:true,opacity:0.85,flatShading:true}));\n    grp.add(cap);\n  } else { // complex - bacteriophage\n    const head=T.mesh(new THREE.IcosahedronGeometry(0.5,0), T.mat('#7bc86c',{roughness:0.6,flatShading:true}));\n    head.position.y=0.55; grp.add(head);\n    const tail=T.mesh(new THREE.CylinderGeometry(0.09,0.09,0.6,10), T.mat('#5aa84c',{roughness:0.6}));\n    tail.position.y=-0.05; grp.add(tail);\n    for(let i=0;i<4;i++){\n      const a=i/4*Math.PI*2;\n      const leg=T.mesh(new THREE.CylinderGeometry(0.03,0.03,0.4,6), T.mat('#4a8c3c',{roughness:0.6}));\n      leg.position.set(Math.cos(a)*0.18,-0.42,Math.sin(a)*0.18); leg.rotation.z=Math.cos(a)*0.6; leg.rotation.x=-Math.sin(a)*0.6;\n      grp.add(leg);\n    }\n  }\n  return grp;\n}\n\nfunction rebuild(){\n  const s=g.userData.state;\n  while(holder.children.length) holder.remove(holder.children[0]);\n  holder.add(buildCapsid(s.shape));\n  // core\n  core.material.color.set(s.acid==='DNA' ? '#ffd23f' : '#ff6ec7');\n  core.material.emissive.set(s.acid==='DNA' ? '#7a5a00':'#7a1f5a');\n  holder.add(core);\n  // envelope\n  if(s.envelope){\n    const env=T.mesh(new THREE.SphereGeometry(1.0,20,20), T.mat('#ff9d5c',{transparent:true,opacity:0.22,roughness:0.3}));\n    holder.add(env);\n    for(let i=0;i<12;i++){\n      const a=i/12*Math.PI*2;\n      const sp=T.mesh(new THREE.ConeGeometry(0.05,0.16,6), T.mat('#ff7a3c',{roughness:0.5}));\n      sp.position.set(Math.cos(a)*1.0, (i%3-1)*0.35, Math.sin(a)*1.0);\n      sp.lookAt(0,sp.position.y,0); sp.rotateX(-Math.PI/2);\n      holder.add(sp);\n    }\n  }\n  g.userData.updateLabel();\n}\ng.userData.rebuild = rebuild;\n\n// classification table\nconst table=[\n  {fam:'Adenovirus', shape:'icosahedral', envelope:false, acid:'DNA', dis:'Acute respiratory disease'},\n  {fam:'Herpes Viruses', shape:'icosahedral', envelope:true, acid:'DNA', dis:'Chicken Pox'},\n  {fam:'Orthomyxo Viruses', shape:'helical', envelope:true, acid:'RNA', dis:'Influenza (Flu)'},\n  {fam:'Coronaviruses', shape:'complex', envelope:true, acid:'RNA', dis:'Common cold'},\n];\ng.userData.table=table;\ng.userData.matchFamily=function(){\n  const s=g.userData.state;\n  return table.find(r=>r.shape===s.shape && r.envelope===s.envelope && r.acid===s.acid);\n};\ng.userData.updateLabel=function(){\n  const s=g.userData.state;\n  const m=g.userData.matchFamily();\n  T.attachLabel(g,{title:'Current Virion', accent:'#4fd6ff', width:3.6, lines:[\n    'Capsid|'+s.shape,\n    'Envelope|'+(s.envelope?'YES':'NO'),\n    'Nucleic acid|'+s.acid,\n    'Family|'+(m? m.fam : '— no match —'),\n    'Disease|'+(m? m.dis : '—')\n  ]});\n};\n\ng.userData.customUpdate=(dt,t)=>{ holder.rotation.y = t*0.5; };\nrebuild();\nreturn g;\n",
                          "holder": {
                            "metadata": {
                              "version": 4.6,
                              "type": "Object",
                              "generator": "Object3D.toJSON"
                            },
