                      },
                      {
                        "uuid": "0582072d-52f6-46fb-9976-76c39321370d",
                        "type": "Group",
                        "userData": {
                          "wire": false,
                          "oid": "o50",
                          "custom": true,
                          "icon": "⚽",
                          "displayName": "Icosahedral Capsid",
                          "behaviorDesc": "Icosahedral capsid: 20-faced faceted protein shell (wireframe reveals facets) enclosing DNA core. Click to toggle wireframe/solid. Example: Adenovirus / Herpes. Spins slowly.",
                          "builderCode": "const g=T.group();\nconst shellMat=T.mat('#8a8f98',{roughness:0.4,metalness:0.1,transparent:true,opacity:0.85});\nconst shell=T.mesh(new THREE.IcosahedronGeometry(1.0,0),shellMat);\ng.add(shell);\n// facet vertex dots\nconst geo=new THREE.IcosahedronGeometry(1.0,0);\nconst pos=geo.attributes.position;\nfor(let i=0;i<pos.count;i++){\n  const v=new THREE.Vector3().fromBufferAttribute(pos,i);\n  const d=T.mesh(new THREE.SphereGeometry(0.06,8,8),T.mat('#ffd23f',{emissive:'#5a4a00'}));\n  d.position.copy(v); g.add(d);\n}\n// inner DNA core\nconst core=T.mesh(new THREE.SphereGeometry(0.45,16,16),T.mat('#e74c3c',{emissive:'#3a0000',roughness:0.3}));\ng.add(core);\ng.userData.wire=false;\ng.userData.customUpdate=(dt,t,o)=>{o.rotation.y+=dt*0.35;o.rotation.x+=dt*0.1;};\ng.userData.customClick=(o)=>{o.userData.wire=!o.userData.wire; shellMat.wireframe=o.userData.wire; T.toast('ICOSAHEDRAL: 20 triangular faces, near-spherical protein shell. Example: Adenovirus, Herpes');};\nreturn g;"
                        },
                        "layers": 1,
