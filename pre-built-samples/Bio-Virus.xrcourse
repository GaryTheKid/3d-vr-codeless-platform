                      {
                        "uuid": "32e180a1-8699-46e0-ba03-9b6842ff9373",
                        "type": "Group",
                        "userData": {
                          "oid": "o51",
                          "custom": true,
                          "icon": "🦠",
                          "displayName": "Complex Capsid",
                          "behaviorDesc": "Complex capsid model: polyhedral head + tail sheath + leg-like tail fibers (bacteriophage shape). Click for info. Example: Coronaviruses/bacteriophage class of complex viruses.",
                          "builderCode": "const g=T.group();\nconst head=T.mesh(new THREE.IcosahedronGeometry(0.6,0),T.mat('#2e8b57',{roughness:0.5}));\nhead.position.y=0.9; g.add(head);\nconst tail=T.mesh(new THREE.CylinderGeometry(0.13,0.13,0.9,10),T.mat('#3aa76d',{roughness:0.5}));\ntail.position.y=0.15; g.add(tail);\nconst plate=T.mesh(new THREE.CylinderGeometry(0.28,0.28,0.1,8),T.mat('#276f47',{roughness:0.5}));\nplate.position.y=-0.3; g.add(plate);\n// leg fibers\nfor(let i=0;i<6;i++){\n  const a=i/6*Math.PI*2;\n  const leg=T.mesh(new THREE.CylinderGeometry(0.035,0.035,0.7,6),T.mat('#276f47',{roughness:0.6}));\n  leg.position.set(Math.cos(a)*0.28,-0.6,Math.sin(a)*0.28);\n  leg.rotation.z=Math.cos(a)*0.5; leg.rotation.x=-Math.sin(a)*0.5;\n  g.add(leg);\n}\ng.userData.customUpdate=(dt,t,o)=>{o.rotation.y+=dt*0.3;};\ng.userData.customClick=(o)=>{T.toast('COMPLEX: intricate shape (head + tail + fibers), not simple helical or icosahedral. Example: bacteriophage / Coronavirus class');};\nreturn g;"
                        },
