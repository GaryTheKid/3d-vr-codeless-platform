            },
            {
              "id": "sec_msgpywdpfvzd",
              "title": "Predict the Shape: Practice Set",
              "type": "quiz",
              "summary": "Practice Problems ClF4-, NH3, C2H2, SF4, CH3COOH and Solutions, pg. 6",
              "purpose": "Verify students can produce full geometry predictions including multiple bonds, lone pairs, hypervalency, and multi-central-atom molecules.",
              "vr": {},
              "reading": {
                "chunks": []
              },
              "h5": {
                "prompt": "",
                "html": "",
                "status": "idle",
                "followUp": null
              },
              "quiz": {
                "items": [
                  {
                    "id": "q_msgq086gba8a",
                    "type": "mcq",
                    "question": "Consider the ion NO3- (nitrogen central, bonded to three oxygens with one N=O double bond and two N-O single bonds, no lone pairs on N). How many electron domains does nitrogen have?",
                    "options": [
                      "3",
                      "4",
                      "5",
                      "6"
                    ],
                    "answer": "0",
                    "explanation": "Each bond — single or double — counts as ONE domain (aha2). Three bonding groups = 3 domains. Counting the double bond as two would wrongly give 4."
                  },
                  {
                    "id": "q_msgq086ghu18",
                    "type": "mcq",
                    "question": "A central sulfur atom has 4 domains total: 3 bonded to fluorine and 1 lone pair. What is the electron-domain geometry AND the molecular geometry?",
                    "options": [
                      "Tetrahedral domain geometry; tetrahedral molecular geometry",
                      "Tetrahedral domain geometry; trigonal pyramidal molecular geometry",
                      "Trigonal pyramidal domain geometry; trigonal pyramidal molecular geometry",
                      "Trigonal planar domain geometry; bent molecular geometry"
                    ],
                    "answer": "1",
                    "explanation": "Domain geometry counts all 4 domains → tetrahedral. Molecular geometry describes only the 3 atoms with one lone pair present → trigonal pyramidal (aha3). Reporting tetrahedral for both ignores the invisible lone pair."
                  },
                  {
                    "id": "q_msgq086gzpar",
                    "type": "short",
                    "question": "XeF2 has a xenon center bonded to two fluorines with three lone pairs on Xe (5 domains total). Give the bond angle between the two Xe-F bonds and state which principle forces that value.",
                    "options": [
                      "",
                      "",
                      "",
                      ""
                    ],
                    "answer": "180",
                    "explanation": "With 5 domains (trigonal bipyramidal), the 3 lone pairs occupy equatorial positions and the two F atoms sit axially, so F-Xe-F is 180° (linear molecular shape). This follows from electron pairs spreading to maximize separation — repulsion alone dictates geometry (aha1), not memorization."
                  },
                  {
                    "id": "q_msgq086gs1r7",
                    "type": "mcq",
                    "question": "For a central atom with 3 bonding domains and 0 lone pairs (e.g., BF3), what is the ideal bond angle?",
                    "options": [
                      "90°",
                      "109.5°",
                      "120°",
                      "180°"
                    ],
                    "answer": "2",
                    "explanation": "Three domains maximize separation as trigonal planar → 120° (aha1, n11)."
                  }
                ]
              },
