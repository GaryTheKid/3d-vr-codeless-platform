                                "generator": "Object3D.toJSON"
                              },
                              "geometries": [
                                {
                                  "uuid": "97e06b10-9409-4b86-803c-cd423a04ff75",
                                  "type": "SphereGeometry",
                                  "radius": 0.34,
                                  "widthSegments": 18,
                                  "heightSegments": 18,
                                  "phiStart": 0,
                                  "phiLength": 6.283185307179586,
                                  "thetaStart": 0,
                                  "thetaLength": 3.141592653589793
                                }
                              ],
                              "materials": [
                                {
                                  "uuid": "69ab8f12-e925-4949-a90a-0a0bc35151d6",
                                  "type": "MeshStandardMaterial",
                                  "color": 8038655,
                                  "roughness": 0.55,
                                  "metalness": 0.08,
                                  "emissive": 2771610,
                                  "emissiveIntensity": 0.5,
                                  "envMapIntensity": 1,
