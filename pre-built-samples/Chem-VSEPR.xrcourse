    "knowledgeGraph": {
      "version": 1,
      "level": "high",
      "anchorExample": "CO2 (linear) contrasted with H2O (bent) — same '2 things around' feel, but lone pairs change the story.",
      "courseTitle": "VSEPR Theory: Predicting Molecular Shape",
      "courseGoal": "Given any molecular formula, draw a valid Lewis structure, count electron domains, and correctly predict electron-domain geometry, molecular geometry, and bond angles.",
      "nodes": [
        {
          "id": "n1",
          "kind": "concept",
          "label": "Valence electrons",
          "mastery": "Sum valence electrons for any molecule/ion correctly.",
          "notes": "",
          "coverage": "planned"
        },
        {
          "id": "n2",
          "kind": "skill",
          "label": "Choosing the central atom",
          "mastery": "Pick the least electronegative atom as central.",
          "notes": "",
          "coverage": "planned"
        },
        {
          "id": "n3",
