        {
          "uuid": "b001b7f8-6d4e-45f9-ac5b-c618c0c934d6",
          "type": "Group",
          "userData": {
            "showLP": true,
            "tilt": 1.1868238913561442,
            "targetTilt": 1.1868238913561442,
            "oid": "o39",
            "custom": true,
            "icon": "🔺",
            "displayName": "NH3 Lone-Pair Model",
            "behaviorDesc": "NH3 model with 4 electron domains (3 N-H bonds + 1 lone-pair cloud). Click to toggle the lone pair: hidden -> relaxes to ideal tetrahedral 109.5deg; shown -> compresses to real 107deg (trigonal pyramidal). Live label names electron-domain geometry (tetrahedral) vs molecular geometry (trigonal pyramidal).",
            "builderCode": "\nconst g = T.group();\nconst N = T.mesh(new THREE.SphereGeometry(0.4,24,24), T.mat(0x3a6bd6,{roughness:0.4}));\ng.add(N);\ng.userData.showLP = true;\nconst TILT_REAL  = 68*Math.PI/180;\nconst TILT_IDEAL = 70.5*Math.PI/180;\ng.userData.tilt = TILT_REAL; g.userData.targetTilt = TILT_REAL;\nconst L=1.3;\nconst hs=[], bonds=[];\nfor(let i=0;i<3;i++){\n  const h=T.mesh(new THREE.SphereGeometry(0.26,20,20),T.mat(0xffffff,{roughness:0.5}));\n  g.add(h); hs.push(h);\n  const b=T.bond(new THREE.Vector3(0,0,0),new THREE.Vector3(0,-1,0),0.07,0xcfd6dd);\n  g.add(b); bonds.push(b);\n}\nconst lp=T.mesh(new THREE.SphereGeometry(0.34,18,18),T.mat(0x7aa8ff,{transparent:true,opacity:0.45,emissive:0x2a4a9a,emissiveIntensity:0.5}));\ng.add(lp); g.userData.lp=lp;\ng.userData.layout=function(tilt){\n  for(let i=0;i<3;i++){\n    const a=i/3*Math.PI*2;\n    const dir=new THREE.Vector3(Math.sin(tilt)*Math.cos(a), -Math.cos(tilt), Math.sin(tilt)*Math.sin(a));\n    hs[i].position.copy(dir.clone().multiplyScalar(L));\n    bonds[i].position.copy(dir.clone().multiplyScalar(L*0.5));\n    bonds[i].quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),dir.clone().normalize());\n    bonds[i].scale.set(1,L,1);\n  }\n  lp.position.set(0,0.9,0);\n};\ng.userData.layout(g.userData.tilt);\nT.attachLabel(g,{\n  title:'NH\\u2083', accent:'#3a6bd6', width:3.6,\n  live:()=>{\n    const s=g.userData.showLP;\n    return [\n      'Domains|4 (3 bond + 1 lone)',\n      'e\\u207B-domain geom|Tetrahedral',\n      'Molecular geom|'+(s?'Trigonal pyramidal':'(hidden LP)'),\n      'Bond angle|'+(s?'107\\u00B0':'109.5\\u00B0'),\n      'Lone pairs|'+(s?'SHOWN':'HIDDEN \\u2014 click'),\n    ];\n  }\n});\ng.userData.customClick=(obj)=>{\n  obj.userData.showLP=!obj.userData.showLP;\n  obj.userData.targetTilt=obj.userData.showLP?TILT_REAL:TILT_IDEAL;\n  if(obj.userData.showLP) T.toast('Lone pair SHOWN \\u2014 it pushes the 3 H down, angle shrinks to 107\\u00B0 (trigonal pyramidal).');\n  else T.toast('Lone pair HIDDEN \\u2014 with only atoms the shape looks ideal 109.5\\u00B0.');\n};\ng.userData.customUpdate=(dt,t,obj)=>{\n  const cur=obj.userData.tilt,tgt=obj.userData.targetTilt;\n  obj.userData.tilt=cur+(tgt-cur)*Math.min(1,dt*4);\n  obj.userData.layout(obj.userData.tilt);\n  const target=obj.userData.showLP?0.45:0.0;\n  const m=obj.userData.lp.material;\n  m.opacity+=(target-m.opacity)*Math.min(1,dt*4);\n  obj.userData.lp.visible=m.opacity>0.02;\n};\nreturn g;\n",
