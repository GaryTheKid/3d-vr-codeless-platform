            ],
            "radii": [
              1,
              0.75,
              1.1
            ],
            "spinning": false,
            "oid": "o78",
            "custom": true,
            "icon": "⚙️",
            "displayName": "Three-Gear Train (turn the driver)",
            "behaviorDesc": "A craft-stick gear train of 3 spur gears that mesh. Click to spin the driver; each gear carries an arrow that flips direction at each mesh (aha2). Includes a 4th ghost gear for prediction.",
            "builderCode": "\nconst g = T.group();\n\nconst stick = T.mesh(new THREE.BoxGeometry(9.5,0.9,0.35), T.mat('#e0b24a',{roughness:0.7}));\nstick.position.set(0.7,0,-0.35);\ng.add(stick);\n\nfunction makeGear(teeth, radius, color){\n  const gg = T.group();\n  const body = T.mesh(new THREE.CylinderGeometry(radius,radius,0.35,32), T.mat(color,{roughness:0.5,metalness:0.2}));\n  body.rotation.x = Math.PI/2;\n  gg.add(body);\n  const hub = T.mesh(new THREE.CylinderGeometry(radius*0.25,radius*0.25,0.45,20), T.mat('#333',{}));\n  hub.rotation.x = Math.PI/2;\n  gg.add(hub);\n  for(let i=0;i<teeth;i++){\n    const a = i/teeth*Math.PI*2;\n    const tooth = T.mesh(new THREE.BoxGeometry(0.18,0.28,0.34), T.mat(color,{roughness:0.5}));\n    tooth.position.set(Math.cos(a)*radius, Math.sin(a)*radius, 0);\n    tooth.rotation.z = a;\n    gg.add(tooth);\n  }\n  const arrow = T.group();\n  const shaft = T.mesh(new THREE.BoxGeometry(0.12,radius*0.7,0.05), T.mat('#ffffff',{emissive:'#ffffff'}));\n  shaft.position.y = radius*0.35;\n  arrow.add(shaft);\n  const head = T.mesh(new THREE.ConeGeometry(0.18,0.3,12), T.mat('#ff3030',{emissive:'#661010'}));\n  head.position.y = radius*0.7;\n  arrow.add(head);\n  arrow.position.z = 0.2;\n  gg.add(arrow);\n  gg.userData.arrow = arrow;\n  return gg;\n}\n\nconst r1=1.0, r2=0.75, r3=1.1, gap=0.28;\nconst gA = makeGear(16, r1, '#8a8f96'); gA.position.set(-3.2,0,0);\nconst gB = makeGear(12, r2, '#c0c5cc'); gB.position.set(-3.2+(r1+r2+gap),0,0);\nconst gC = makeGear(18, r3, '#8a8f96'); gC.position.set(-3.2+(r1+r2+gap)+(r2+r3+gap),0,0);\ng.add(gA); g.add(gB); g.add(gC);\n\nconst gD = makeGear(14, 0.9, '#4fd6ff');\ngD.position.set(gC.position.x+(r3+0.9+gap),0,0);\ngD.children.forEach(c=>{ if(c.material){c.material.transparent=true;c.material.opacity=0.28;} });\ngD.userData.arrow.visible=false;\ngD.userData.ghost=true;\ng.add(gD);\n\ng.userData.gears=[gA,gB,gC];\ng.userData.ghost=gD;\ng.userData.radii=[r1,r2,r3];\ng.userData.spinning=false;\n\ng.userData.customUpdate=(dt,t,o)=>{\n  if(!o.userData.spinning) return;\n  const base=1.2, rad=o.userData.radii;\n  let dir=1;\n  o.userData.gears.forEach((gear,i)=>{\n    gear.rotation.z += dir*base*(rad[0]/rad[i])*dt;\n    dir*=-1;\n  });\n  const gh=o.userData.ghost;\n  if(gh.userData.arrow.visible){\n    gh.rotation.z += dir*base*(rad[0]/0.9)*dt;\n  }\n};\n\ng.userData.customClick=(o)=>{\n  o.userData.spinning=!o.userData.spinning;\n  T.toast(o.userData.spinning? 'Driver A turning! Watch each arrow flip at every mesh.' : 'Stopped. A to B to C: arrows point opposite at each mesh.');\n};\n\nreturn g;\n",
            "ghost": {
