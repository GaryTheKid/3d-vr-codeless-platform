            },
            {
              "id": "sec_msgs92h9hxq7",
              "title": "Which Way Does It Turn?",
              "type": "vr",
              "summary": "Step 1 observation of turning one gear and watching the other; three-gear train photo.",
              "purpose": "Student mounts a gear chain, adds arrow stickers, and discovers meshed gears alternate direction.",
              "vr": {
                "scene": {
                  "metadata": {
                    "version": 4.6,
                    "type": "Object",
                    "generator": "Object3D.toJSON"
                  },
