      "ahaKeys": [
        {
          "id": "aha1",
          "insight": "A gear ratio is just driven teeth over driver teeth — count the teeth and you know the speed change.",
          "whyKey": "Every gear-ratio problem, no matter the gear sizes or story, reduces to counting teeth on the output gear and the input gear and dividing.",
          "misconception": "Students think the ratio depends on gear color, physical size guessed by eye, or which gear 'looks stronger' rather than the exact tooth count.",
          "buildIdea": "Give two meshed gears; student marks one tooth on each with tape, turns the driver one full turn, and counts how many turns the driven gear makes — then checks it matches teeth(driver)/teeth(driven).",
          "nodeIds": [
            "n5",
            "n6",
            "n7"
          ]
        },
        {
          "id": "aha2",
          "insight": "Meshed gears always spin opposite ways, so each extra gear flips the direction again.",
          "whyKey": "Predicting output direction for any train is just counting how many meshes flip the rotation; odd flips reverse, even flips keep same.",
          "misconception": "Students assume all gears in a train turn the same way, or that adding gears speeds things up.",
          "buildIdea": "Student mounts a chain of three gears, puts an arrow sticker on each, turns the first, and watches arrows alternate direction — then predicts the arrow direction for a 4th gear before adding it.",
          "nodeIds": [
            "n2",
            "n3",
            "n8"
          ]
        },
        {
          "id": "aha3",
          "insight": "An idler gear in the middle changes direction but NOT the overall ratio — its teeth cancel out.",
          "whyKey": "Learners stop wasting gears trying to boost ratio and realize only first-driver and last-driven teeth set the overall simple-train ratio.",
          "misconception": "Students believe every added gear multiplies the speed or that middle gears change the ratio.",
          "buildIdea": "Student compares a 2-gear set to the same two gears with an idler wedged between, measures output turns for one input turn, and finds the ratio identical but direction flipped.",
          "nodeIds": [
            "n8",
            "n9"
          ]
        },
        {
          "id": "aha4",
          "insight": "A compound gear shares one shaft, so you multiply the ratio of each meshing pair to get huge overall ratios.",
          "whyKey": "Reaching targets like 8:1 is impossible with one pair but easy once you see that stacking gears on a shaft multiplies stage ratios.",
          "misconception": "Students think a compound gear just adds ratios, or that one giant gear alone can hit 8:1.",
          "buildIdea": "Student builds a two-stage compound train, computes each pair's ratio, multiplies them, then turns the input and counts output turns to confirm the product matches.",
          "nodeIds": [
            "n10",
            "n11",
            "n12"
          ]
        }
      ],
      "sourceFilename": "Mecha-Gear.pdf",
      "updatedAt": 1785976426699
    }
