                      {
                        "uuid": "5f26c03e-9cf4-49b2-a5e9-57a32f6bbe83",
                        "type": "Group",
                        "userData": {
                          "quiz": {
                            "correct": 1,
                            "done": false,
                            "tries": 0
                          },
                          "oid": "o87",
                          "builderCode": "const spec = {\"question\":\"A 10t driver meshes a 15t idler, then a 30t driven. Overall ratio & direction?\",\"options\":[\"A. 3:1, driven turns OPPOSITE to driver\",\"B. 3:1, driven turns SAME way as driver\",\"C. 4.5:1, because the idler adds teeth\",\"D. 1.5:1, the idler sets the ratio\"],\"correct\":1,\"okMsg\":\"Right! Ratio = 30/10 = 3:1 (idler cancels). Two meshes = two flips = SAME direction.\",\"noMsg\":\"The idler never changes the ratio — use only 1st & last teeth: 30/10 = 3:1. Count the flips: 2 meshes = same direction.\",\"accent\":\"#33cc66\",\"hint\":\"Tap an option below\"};\nconst g = T.group();\nconst W = 3.8;\nconst gap = 0.12;\nconst q = T.makePanel({ title: spec.question, lines: [spec.hint], width: W, accent: spec.accent });\nconst qH = q.userData.panelH || 1.15;\nq.position.set(0, 0, 0);\ng.add(q);\nlet cursor = -qH / 2 - gap;\nspec.options.forEach((opt, i) => {\n  const btn = T.makePanel({ lines: [opt], width: W, accent: '#9aa3af' });\n  const bH = btn.userData.panelH || 0.72;\n  cursor -= bH / 2;\n  btn.position.set(0, cursor, 0.04);\n  cursor -= bH / 2 + gap;\n  btn.userData.optIndex = i;\n  g.add(btn);\n});\ng.userData.quiz = { correct: spec.correct, done: false, tries: 0 };\ng.userData.onActivate = (obj, detail) => {\n  if (obj.userData.quiz.done || !detail || !detail.point) return;\n  let best = null, bd = 1e9;\n  obj.traverse(c => {\n    if (c.userData.optIndex === undefined) return;\n    const wp = c.getWorldPosition(new T.THREE.Vector3());\n    const d = wp.distanceTo(detail.point);\n    if (d < bd) { bd = d; best = c; }\n  });\n  if (!best || bd > 2.2) return;\n  obj.userData.quiz.tries += 1;\n  const hit = best;\n  hit.scale.setScalar(1.12);\n  setTimeout(() => hit.scale.setScalar(1), 220);\n  if (hit.userData.optIndex === obj.userData.quiz.correct) {\n    obj.userData.quiz.done = true;\n    T.notify('✅ ' + spec.okMsg, { at: obj });\n  } else {\n    T.notify('❌ ' + spec.noMsg, { at: obj });\n  }\n};\nreturn g;",
                          "icon": "❓",
                          "displayName": "Idler Ratio Quiz",
                          "behaviorDesc": "Quiz: \"A 10t driver meshes a 15t idler, then a 30t driven. Overall ratio & direction?\"; on correct answer userData.quiz.done=true (readable by other objects as an unlock condition)"
                        },
                        "layers": 1,
                        "matrix": [
