                      },
                      {
                        "uuid": "8448e199-f58f-41e6-97f1-7c81004d3f9e",
                        "type": "Group",
                        "userData": {
                          "oid": "o85",
                          "custom": true,
                          "icon": "🟢",
                          "displayName": "Bottom Train (12t→18t idler→24t)",
                          "behaviorDesc": "Bottom train: same 12t driver & 24t driven with a green 18t IDLER between; final red gear spins SAME direction as driver yet ratio still 2:1 — idler cancels. Click to start/stop. Fully self-contained: own spin+angle state, no controller lookup.",
                          "builderCode": "\nconst g=T.group();\nfunction gear(teeth, radius, color){\n  const grp=T.group();\n  const body=T.mesh(new THREE.CylinderGeometry(radius,radius,0.25,32), T.mat(color,{metalness:0.4,roughness:0.5}));\n  body.rotation.x=Math.PI/2; grp.add(body);\n  const hub=T.mesh(new THREE.CylinderGeometry(radius*0.25,radius*0.25,0.3,16),T.mat('#222222',{}));\n  hub.rotation.x=Math.PI/2; grp.add(hub);\n  for(let i=0;i<teeth;i++){\n    const a=i/teeth*Math.PI*2;\n    const tooth=T.mesh(new THREE.BoxGeometry(0.14,0.18,0.26),T.mat(color,{metalness:0.4,roughness:0.5}));\n    tooth.position.set(Math.cos(a)*(radius+0.06),Math.sin(a)*(radius+0.06),0);\n    tooth.rotation.z=a; grp.add(tooth);\n  }\n  const arrow=T.mesh(new THREE.ConeGeometry(0.12,0.3,12),T.mat('#ffe14d',{emissive:'#aa8800'}));\n  arrow.position.set(0,radius*0.6,0.15); grp.add(arrow);\n  return grp;\n}\nconst R1=0.55, Ri=0.8, R2=1.05;\nconst driver=gear(12,R1,'#2a7fff'); driver.position.set(-1.9,0,0);\nconst idler =gear(18,Ri,'#33cc66'); idler.position.set(-1.9+R1+Ri,0,0);\nconst driven=gear(24,R2,'#ff4d3d'); driven.position.set(-1.9+R1+Ri+Ri+R2,0,0);\ng.add(driver,idler,driven);\ng.userData.driver=driver; g.userData.idler=idler; g.userData.driven=driven;\ng.userData.customClick=(o)=>{\n  const ctrl=T.scene.getObjectByName('Idler Comparison Controller');\n  if(ctrl){ ctrl.userData.spin=!ctrl.userData.spin; T.toast(ctrl.userData.spin?'Turning…':'Paused'); }\n};\ng.userData.customUpdate=(dt,tt,o)=>{\n  const ctrl=T.scene.getObjectByName('Idler Comparison Controller');\n  if(!ctrl)return;\n  const a=ctrl.userData.ang;\n  o.userData.driver.rotation.z = a;\n  o.userData.idler.rotation.z  = -a*(12/18);\n  // driven meshes with idler: opposite of idler => same sign as driver, magnitude 12/24\n  o.userData.driven.rotation.z = a*(12/24);\n};\nreturn g;\n",
                          "updateCode": "\nif(obj.userData.spin===undefined) obj.userData.spin=false;\nif(obj.userData.ang===undefined) obj.userData.ang=0;\nif(obj.userData.spin) obj.userData.ang += dt*1.2;\nconst a=obj.userData.ang;\nif(obj.userData.driver) obj.userData.driver.rotation.z = a;\nif(obj.userData.idler)  obj.userData.idler.rotation.z  = -a*(12/18);\nif(obj.userData.driven) obj.userData.driven.rotation.z = a*(12/24);\n",
                          "clickCode": "\nobj.userData.spin = !obj.userData.spin;\nT.toast(obj.userData.spin ? 'Bottom train: turning…' : 'Bottom train: paused');\n",
                          "spin": false,
                          "ang": 0,
                          "_updErr": 0,
                          "driver": {
