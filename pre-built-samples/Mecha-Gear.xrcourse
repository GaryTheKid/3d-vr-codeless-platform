            {
              "id": "sec_msgs92h9qjas",
              "title": "Design Challenge & Wrap-Up",
              "type": "quiz",
              "summary": "Sharing/Generalizing questions and the 8:1 compound design task.",
              "purpose": "Learners design an 8:1 compound train to spec and answer reflection questions verifying all keys.",
              "vr": {},
              "reading": {
                "chunks": []
              },
              "h5": {
                "prompt": "",
                "html": "",
                "status": "idle",
                "followUp": null
              },
              "quiz": {
                "items": [
                  {
                    "id": "q_msgs9mnbqaq5",
                    "type": "mcq",
                    "question": "A clockmaker builds a two-stage compound train. The first meshing pair has a ratio of 4:1 and the second meshing pair has a ratio of 3:1. What is the overall ratio from input to final output?",
                    "options": [
                      "7:1",
                      "12:1",
                      "1:12",
                      "3.5:1"
                    ],
                    "answer": "1",
                    "explanation": "Compound stages multiply, not add: 4 × 3 = 12:1. This installs aha4 in a new clock context — students who think you add ratios pick 7:1."
                  },
                  {
                    "id": "q_msgs9mnbqooz",
                    "type": "mcq",
                    "question": "An engineer needs a 9:1 speed reduction for a robot wheel but only has small gears. Which approach works?",
                    "options": [
                      "Use one giant gear that alone gives 9:1",
                      "Stack two gears on a shared shaft so each meshing pair's ratio multiplies to 9:1 (e.g. 3:1 then 3:1)",
                      "Add nine idler gears in a row",
                      "Pick the gear that looks strongest"
                    ],
                    "answer": "1",
                    "explanation": "A single reasonable gear can't reach 9:1; a compound gear sharing a shaft lets stage ratios multiply (3×3=9). Defeats the 'one giant gear' and 'looks strongest' misconceptions."
                  },
                  {
                    "id": "q_msgs9mnbmgvd",
                    "type": "mcq",
                    "question": "A bicycle mechanic sees two meshed gears with 60 teeth (driver) and 15 teeth (driven). Painted colors: driver blue, driven red. What is the gear ratio and does the driven gear speed up or slow down?",
                    "options": [
                      "4:1 speed increase — count teeth: 60/15",
                      "1:4, decides by which is blue",
                      "4:1 but only because the red gear is smaller-looking",
                      "Cannot tell without knowing which is stronger"
                    ],
                    "answer": "0",
                    "explanation": "Ratio = driven-relevant tooth count; driver 60 / driven 15 = 4:1, driven turns 4× faster. Color and 'strength' are irrelevant — this installs aha1."
                  },
                  {
                    "id": "q_msgs9mnbnazi",
                    "type": "short",
                    "question": "In your own words, describe what a drive train is and why a compound gear is useful for reaching a target like 8:1.",
                    "options": [],
                    "answer": "drive train",
                    "explanation": "A drive train is a set of gears connected to transmit rotational motion for a purpose (n14). A compound gear (two gears fixed on one shaft) lets you multiply stage ratios, so stacking pairs reaches large ratios like 8:1 that one pair cannot (n11, aha4)."
                  }
                ]
              },
              "covers": [
