                      {
                        "uuid": "f627b1fb-6e3d-49d7-b013-38cfccfc54bf",
                        "type": "Group",
                        "userData": {
                          "running": false,
                          "ang": 0,
                          "inputTurns": 0,
                          "baseSpeed": 0.9,
                          "oid": "o92",
                          "custom": true,
                          "icon": "⚙️",
                          "displayName": "Compound Gear Train (8:1)",
                          "behaviorDesc": "Self-contained compound gear train. Input 10t drives big 20t (stage 1 = 2:1); small 10t is fixed on the SAME shaft as big 20t and drives output 40t (stage 2 = 4:1). Overall 2x4 = 8:1. Output spins 8x the input speed, opposite direction from big gear. Click to start/stop; state & angle stored on itself — no cross-object lookups. Live panel shows the multiplied ratio and turn counts.",
                          "builderCode": "\nconst g = T.group();\nconst TH = T.THREE;\n\n// ---- helper: build a spur gear as a group ----\nfunction makeGear(teeth, radius, color, thickness){\n  const gear = T.group();\n  const body = T.mesh(new TH.CylinderGeometry(radius, radius, thickness, 28), T.mat(color,{roughness:0.5,metalness:0.3}));\n  body.rotation.x = Math.PI/2; // face +z\n  gear.add(body);\n  // hub\n  const hub = T.mesh(new TH.CylinderGeometry(radius*0.22, radius*0.22, thickness*1.3, 16), T.mat(0x222831,{roughness:0.6}));\n  hub.rotation.x = Math.PI/2;\n  gear.add(hub);\n  // teeth\n  const toothMat = T.mat(color,{roughness:0.5,metalness:0.3});\n  const tw = (2*Math.PI*radius)/teeth*0.55;\n  for(let i=0;i<teeth;i++){\n    const a = i/teeth*Math.PI*2;\n    const t = T.mesh(new TH.BoxGeometry(tw, radius*0.28, thickness), toothMat);\n    t.position.set(Math.cos(a)*(radius+radius*0.12), Math.sin(a)*(radius+radius*0.12), 0);\n    t.rotation.z = a;\n    gear.add(t);\n  }\n  // one white marker tooth so students can count turns\n  const mark = T.mesh(new TH.BoxGeometry(tw*1.1, radius*0.3, thickness*1.05), T.mat(0xffffff,{emissive:0xffffff,emissiveIntensity:0.4}));\n  mark.position.set(radius+radius*0.12, 0, 0);\n  gear.add(mark);\n  gear.userData.teeth = teeth;\n  gear.userData.radius = radius;\n  return gear;\n}\n\n// module (tooth size) shared so gears mesh: radius ≈ teeth * m\nconst m = 0.045;\nconst th = 0.16;\n\n// Stage 1: input 10t -> big 20t\nconst inputG = makeGear(10, 10*m, 0x4a9eff, th);   // blue input\nconst bigG   = makeGear(20, 20*m, 0xe0483a, th);    // red big (on shaft)\n// Stage 2: small 10t (same shaft as big) -> output 40t\nconst smallG = makeGear(10, 10*m, 0xf0c840, th*0.9); // yellow small on shaft\nconst outG   = makeGear(40, 40*m, 0x3fb96f, th);     // green output\n\n// --- positions (mesh: center distance = r1 + r2) ---\n// input at left, big to its right (meshing)\nconst rIn = 10*m, rBig = 20*m, rSm = 10*m, rOut = 40*m;\ninputG.position.set(-(rIn+rBig), 0.9, 0);   // left\nbigG.position.set(0, 0.9, 0);               // shaft center\nsmallG.position.set(0, 0.9, th*0.9);        // same shaft, offset in z\n// output meshes with small gear -> below the shaft\nconst d2 = rSm + rOut;\noutG.position.set(0, 0.9 - d2, th*0.9);     // below, on the small-gear plane\n\ng.add(inputG); g.add(bigG); g.add(smallG); g.add(outG);\n\n// --- shaft rod through big + small (shows they share one shaft) ---\nconst shaft = T.mesh(new TH.CylinderGeometry(0.05,0.05, th*3.2, 12), T.mat(0x9aa0a6,{metalness:0.7,roughness:0.3}));\nshaft.rotation.x = Math.PI/2;\nshaft.position.set(0, 0.9, th*0.9/2);\ng.add(shaft);\n// input axle & output axle stubs\n[[-(rIn+rBig),0.9,0],[0,0.9-d2,th*0.9]].forEach(p=>{\n  const ax = T.mesh(new TH.CylinderGeometry(0.045,0.045, th*1.8,12), T.mat(0x9aa0a6,{metalness:0.7}));\n  ax.rotation.x = Math.PI/2; ax.position.set(p[0],p[1],p[2]); g.add(ax);\n});\n\n// backing board\nconst board = T.mesh(new TH.BoxGeometry(2.6, 3.4, 0.08), T.mat(0xcaa96b,{roughness:0.9}));\nboard.position.set(-0.55, 0.0, -0.15);\ng.add(board);\n\n// motor block behind input\nconst motor = T.mesh(new TH.BoxGeometry(0.5,0.5,0.5), T.mat(0x2b2f36,{roughness:0.7}));\nmotor.position.set(-(rIn+rBig), 0.9, -0.35);\ng.add(motor);\n\n// store refs & state on itself\ng.userData.inputG = inputG;\ng.userData.bigG = bigG;\ng.userData.smallG = smallG;\ng.userData.outG = outG;\ng.userData.running = false;\ng.userData.ang = 0;          // input angle\ng.userData.inputTurns = 0;\ng.userData.baseSpeed = 0.9;  // input rad/s\n\n// live data panel\nT.attachLabel(g, {\n  title: 'Compound Ratio',\n  accent: '#f0a848',\n  width: 3.4,\n  live: ()=>{\n    const inT = g.userData.inputTurns;\n    return [\n      'Stage 1: 20t / 10t = 2:1',\n      'Stage 2: 40t / 10t = 4:1',\n      'Overall = 2 x 4 = 8 : 1',\n      '',\n      'Input turns: ' + inT.toFixed(2),\n      'Output turns: ' + (inT/8).toFixed(3),\n      g.userData.running ? '\\u25b6 running (click to stop)' : '\\u23f8 click gears to run'\n    ];\n  }\n});\n\n// click to start/stop\ng.userData.customClick = (obj)=>{\n  obj.userData.running = !obj.userData.running;\n  T.toast(obj.userData.running ? 'Running: watch the output creep — 8 input turns = 1 output turn' : 'Paused');\n};\n\n// per-frame drive\ng.userData.customUpdate = (dt, t, obj)=>{\n  if(!obj.userData.running) return;\n  const s = obj.userData.baseSpeed;\n  const d = s*dt;                 // input rotation this frame\n  obj.userData.ang += d;\n  obj.userData.inputTurns += d/(Math.PI*2);\n  const u = obj.userData;\n  // input spins +; big meshes -> opposite, at 10/20 = 1/2 speed\n  u.inputG.rotation.z += d;\n  const bigDelta = -d * (10/20);\n  u.bigG.rotation.z += bigDelta;\n  u.smallG.rotation.z += bigDelta;         // small shares shaft with big\n  // output meshes small -> opposite of small, at 10/40 speed relative to small\n  u.outG.rotation.z += -bigDelta * (10/40);\n};\n\nreturn g;\n",
                          "_updErr": 0,
                          "inputG": {
                            "metadata": {
                              "version": 4.6,
                              "type": "Object",
                              "generator": "Object3D.toJSON"
                            },
