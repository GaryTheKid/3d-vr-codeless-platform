                      {
                        "uuid": "5342e788-7c21-4543-afcb-9da3a0fe631a",
                        "type": "Group",
                        "userData": {
                          "oid": "o79",
                          "custom": true,
                          "icon": "🔮",
                          "displayName": "Predict Gear D button",
                          "behaviorDesc": "Prediction button for aha2: click to reveal gear D (the 4th gear) and its direction. 3 meshes = 3 flips = opposite to A.",
                          "builderCode": "\nconst g=T.group();\nconst base=T.mesh(new THREE.CylinderGeometry(0.6,0.6,0.3,24),T.mat('#4fd6ff',{emissive:'#123344'}));\ng.add(base);\nconst top=T.mesh(new THREE.ConeGeometry(0.35,0.5,20),T.mat('#4fd6ff',{emissive:'#123344'}));\ntop.position.y=0.4; g.add(top);\nT.attachLabel(g,{title:'PREDICT before revealing',lines:['Gear D is the 4th gear.','A spins one way.','Will D spin SAME or OPPOSITE to A?','Click to reveal gear D.'],accent:'#4fd6ff',width:3.4});\ng.userData.customClick=(o)=>{\n  let root=o; while(root.parent) root=root.parent;\n  let t=null;\n  root.traverse(n=>{if(n.userData&&n.userData.ghost&&n.userData.gears)t=n;});\n  if(t){ t.userData.ghost.userData.arrow.visible=true; }\n  T.say('<b>Reveal:</b> A to B to C to D has <b>3 meshes = 3 flips</b>. An odd number of flips means D spins <b>OPPOSITE</b> to A. Each extra meshed gear reverses direction again — adding gears does NOT speed things up by itself!');\n  T.toast('Gear D revealed: 3 flips, opposite to A.');\n};\nreturn g;\n"
                        },
