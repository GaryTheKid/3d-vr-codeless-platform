            {
              "id": "sec_msgs92h9n3n2",
              "title": "Ratio Check",
              "type": "quiz",
              "summary": "Questions based on Step 1 and Step 2 ratio and direction findings.",
              "purpose": "Verify learners compute two-gear ratios, predict direction, and understand idlers.",
              "vr": {},
              "reading": {
                "chunks": []
              },
              "h5": {
                "prompt": "",
                "html": "",
                "status": "idle",
                "followUp": null
              },
              "quiz": {
                "items": [
                  {
                    "id": "q_msgs9bymbw42",
                    "type": "mcq",
                    "question": "In a clock mechanism, a driver gear with 12 teeth meshes with a driven gear with 36 teeth. What is the gear ratio, and does the driven gear speed up or slow down?",
                    "options": [
                      "3:1, driven turns slower",
                      "3:1, driven turns faster",
                      "1:3, driven turns faster",
                      "depends on which gear is larger in diameter, not the teeth"
                    ],
                    "answer": "0",
                    "explanation": "Ratio = driven/driver = 36/12 = 3:1. Since the driven gear has more teeth, it turns slower. The tooth count alone determines this (aha1)."
                  },
                  {
                    "id": "q_msgs9bymssot",
                    "type": "short",
                    "question": "A bicycle mechanic has a driver gear of 15 teeth and a driven gear of 45 teeth, but the driver is bright red and the driven is dull gray. Some students say the shiny red gear 'looks stronger' so it sets a bigger ratio. Explain what actually determines the ratio and state it.",
                    "options": [
                      "",
                      "",
                      "",
                      ""
                    ],
                    "answer": "teeth only",
                    "explanation": "Color and appearance are irrelevant (aha1). Ratio = driven teeth / driver teeth = 45/15 = 3:1. Only the exact tooth counts matter."
                  },
                  {
                    "id": "q_msgs9bym83ti",
                    "type": "mcq",
                    "question": "A conveyor system has FOUR meshed gears in a straight line. If the first gear spins clockwise, which way does the fourth gear spin?",
                    "options": [
                      "Clockwise",
                      "Counter-clockwise",
                      "Same as the first because they are all connected",
                      "It stops because there are too many gears"
                    ],
                    "answer": "1",
                    "explanation": "Each mesh reverses direction (aha2). Gear 1 CW, 2 CCW, 3 CW, 4 CCW. Three meshes = odd flips = reversed."
                  },
                  {
                    "id": "q_msgs9bymrtyj",
                    "type": "short",
                    "question": "A toy car has a 10-tooth driver meshing directly with a 30-tooth driven, giving 3:1. A student inserts an extra 20-tooth gear between them, hoping to make it 6:1. What is the new overall ratio and direction compared to before? Explain.",
                    "options": [
                      "",
                      "",
                      "",
                      ""
                    ],
                    "answer": "still 3:1, direction reversed",
                    "explanation": "The middle gear is an idler: it changes direction but its teeth cancel out of the overall ratio (aha3). Ratio stays 30/10 = 3:1; only the direction flips."
                  }
                ]
              },
              "covers": [
                "n5",
                "n6",
                "n7",
                "n8",
                "n9"
              ],
              "role": "consolidation",
              "sourceHint": "Questions based on Step 1 and Step 2 ratio and direction findings.",
              "figureIds": [],
              "installsAha": [
                "aha1",
                "aha2",
                "aha3"
              ],
              "buildStatus": "done"
            }
          ]
        },
