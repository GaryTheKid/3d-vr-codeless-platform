"depth":0.26,"widthSegments":1,"heightSegments":1,"depthSegments":1},{"uuid":"18fbbcfa-eb6c-4550-8136-58e21b6aa40b","type":"BoxGeometry","width":0.14,"height":0.18,"depth":0.26,"widthSegments":1,"heightSegments":1,"depthSegments":1},{"uuid":"2c5a0353-d177-4818-a294-79bbd594e13a","type":"ConeGeometry","radius":0.12,"height":0.3,"radialSegments":12,"heightSegments":1,"openEnded":false,"thetaStart":0,"thetaLength":6.283185307179586},{"uuid":"ff3838c4-bf67-4afc-aa0b-2cb8abcd8f5b","type":"CylinderGeometry","radiusTop":1.05,"radiusBottom":1.05,"height":0.25,"radialSegments":32,"heightSegments":1,"openEnded":false,"thetaStart":0,"thetaLength":6.283185307179586},{"uuid":"bdc01c71-058c-414a-8407-8cf8e1ab20b9","type":"CylinderGeometry","radiusTop":0.2625,"radiusBottom":0.2625,"height":0.3,"radialSegments":16,"heightSegments":1,"openEnded":false,"thetaStart":0,"thetaLength":6.283185307179586},{"uuid":"41e9161f-7dd7-4d45-a9ad-e08756b84d89","type":"BoxGeometry","width":0.14,"height":0.18,"depth":0.26,"widthSegments":1,"heightSegments":1,"depthSegments":1},{"uuid":"e4ba6d5f-d013-4752-aae0-95647d3341ea","type":"BoxGeometry","width":0.14,"height":0.18,"depth":0.26,"widthSegments":1,"heightSegments":1,"depthSegments":1},{"uuid":"9f0576a1-63c4-476d-a6e8-be9b0b7f417c","type":"BoxGeometry","width":0.14,"height":0.18,"depth":0.26,"widthSegments":1,"heightSegments":1,"depthSegments":1},{"uuid":"a7af3285-c866-45b0-9f62-99f728a74bb1","type":"BoxGeometry","width":0.14,"height":0.18,"depth":0.26,"widthSegments":1,"heightSegments":1,"depthSegments":1},{"uuid":"8a7cd0bd-7e5b-4aea-849d-bce2f1925838","type":"BoxGeometry","width":0.14,"height":0.18,"depth":0.26,"widthSegments":1,"heightSegments":1,"depthSegments":1},{"uuid":"cc041ee2-b7ef-49c5-ab4d-12785610d515","type":"BoxGeometry","width":0.14,"height":0.18,"depth":0.26,"widthSegments":1,"heightSegments":1,"depthSegments":1},{"uuid":"e88fc70a-e818-42f4-9efd-72deeb315b7d","type":"BoxGeometry","width":0.14,"height":0.18,"depth":0.26,"widthSegment