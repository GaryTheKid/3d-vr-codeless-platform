-0.6200000047683716,1.1399999856948853,-1.2999999523162842,-0.6200000047683716,2.059999942779541,-1.2999999523162842],"normalized":false}},"boundingSphere":{"center":[0,1.5999999642372131,-0.6499999761581421],"radius":1.0092075877525437}}},{"uuid":"304c1dcd-363d-4ec2-99f5-ff52acd7f32a","type":"ConeGeometry","radius":0.11,"height":0.26,"radialSegments":4,"heightSegments":1,"openEnded":false,"thetaStart":0,"thetaLength":6.283185307179586},{"uuid":"65fc6c2d-7a5c-45d7-901a-5b67a7714154","type":"PlaneGeometry","width":7.5,"height":3.4447674418604652,"widthSegments":1,"heightSegments":1},{"uuid":"2a44d8a4-6db5-4a7c-95a5-32c29431100f","type":"BoxGeometry","width":11.396926207859083,"height":0.06,"depth":2,"widthSegments":1,"heightSegments":1,"depthSegments":1},{"uuid":"9ac44b30-7ba1-4564-8a04-93a5a3193dff","type":"CylinderGeometry","radiusTop":0.05,"radiusBottom":0.05,"height":7.710100716628343,"radialSegments":12,"heightSegments":1,"openEnded":false,"thetaStart":0,"thetaLength":6.283185307179586},{"uuid":"e75ab982-e23c-48f9-9344-9c02766a887f","type":"SphereGeometry","radius":0.28,"widthSegments":20,"heightSegments":20,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"e8cccb0e-d873-437b-ba60-41f10487d881","type":"SphereGeometry","radius":0.24,"widthSegments":16,"heightSegments":16,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"fdc3ff21-5712-4355-b14b-073250df1309","type":"SphereGeometry","radius":0.24,"widthSegments":16,"heightSegments":16,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"a5986274-7b69-4fcc-bc8a-95fc1bbc0f6b","type":"SphereGeometry","radius":0.07,"widthSegments":8,"heightSegments":8,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"f1513df7-548a-49b3-b3c5-6fb96dbafe38","type":"SphereGeometry","radius":0.07,"widthSegments":8,"heightSegments":8,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"d313e869-8522-4095-99a0-7545342c8cf1","type":"SphereGeometry","radius":0.07,"widthSegments":8,"heightSegments":8,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"8af0bc64-b54f-4b32-88cb-dc243176bfd1","type":"SphereGeometry","radius":0.07,"widthSegments":8,"heightSegments":8,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"571ca707-07a6-45a6-9da5-68c5cde47a22","type":"SphereGeometry","radius":0.07,"widthSegments":8,"heightSegments":8,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"aa690ce4-b355-4bb3-954f-30a18f4ce0d7","type":"SphereGeometry","radius":0.07,"widthSegments":8,"heightSegments":8,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"adecc659-ca2e-4b7e-ac2b-3ecff20ed06a","type":"SphereGeometry","radius":0.07,"widthSegments":8,"heightSegments":8,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"95ba3bd0-f76b-4361-9da4-affdddbb5ca0","type":"SphereGeometry","radius":0.07,"widthSegments":8,"heightSegments":8,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"0ea11c22-79dd-4e90-bbf8-1ee6c7a44b90","type":"SphereGeometry","radius":0.07,"widthSegments":8,"heightSegments":8,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"aff6606a-3fb5-454c-b641-ee79184f7f8d","type":"SphereGeometry","radius":0.07,"widthSegments":8,"heightSegments":8,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"4e524784-9ce4-497e-bd21-63d3904d318b","type":"SphereGeometry","radius":0.07,"widthSegments":8,"heightSegments":8,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"9c2789f0-a4a7-4fc8-99a4-7a98507db4fc","type":"SphereGeometry","radius":0.07,"widthSegments":8,"heightSegments":8,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"c442fad0-fa05-421d-8193-abae5bebb495","type":"SphereGeometry","radius":0.07,"widthSegments":8,"heightSegments":8,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"dd7b0656-1ad4-4ce1-a5cf-4099d039bae5","type":"SphereGeometry","radius":0.07,"widthSegments":8,"heightSegments":8,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"fe3f854b-a886-4ae3-8eb4-7697c9fc4100","type":"SphereGeometry","radius":0.07,"widthSegments":8,"heightSegments":8,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"acbf0c35-9149-44b9-a6af-f59e743f512e","type":"SphereGeometry","radius":0.07,"widthSegments":8,"heightSegments":8,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"2a65ecf1-a5b3-4cfb-8090-a59b5d1ebdf3","type":"SphereGeometry","radius":0.07,"widthSegments":8,"heightSegments":8,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"0bd46a7a-e8b7-4204-b092-b68b838dae7b","type":"SphereGeometry","radius":0.07,"widthSegments":8,"heightSegments":8,"phiStart":0,"phiLength":6.283185307179586,"thetaStart":0,"thetaLength":3.141592653589793},{"uuid":"090c510f-3918-4630-be50-131d0f459297","type":"PlaneGeometry","width":7.05,"height":1.110375,"widthSegments":1,"heightSegments":1},{"uuid":"7b111391-057d-4c5f-8a49-ac105101e32d","type":"PlaneGeometry","width":4.25,"height":0.7280092592592593,"widthSegments":1,"heightSegments":1},{"uuid":"a5aaa75f-7c2b-4ff2-9716-a1633a64b2ab","type":"PlaneGeometry","width":3.8,"height":0.7322916666666667,"widthSegments":1,"heightSegments":1},{"uuid":"af856568-ff27-4ed9-a937-6988ff99d0ae","type":"PlaneGeometry","width":5.25,"height":0.7357954545454546,"widthSegments":1,"heightSegments":1},{"uuid":"cfc7919f-ae04-45c5-bffc-753e354ec5d0","type":"PlaneGeometry","width":3.8,"height":0.7322916666666667,"widthSegments":1,"heightSegments":1}],"materials":[{"uuid":"7e9cedfc-8a56-4098-9977-a15b3193d405","type":"MeshStandardMaterial","color":15922424,"roughness":0.5,"metalness":0,"emissive":0,"envMapIntensity":1,"opacity":0.55,"transparent":true,"blendColor":0},{"uuid":"dcb1e483-f639-41b9-82d6-7847b80b8789","type":"MeshBasicMaterial","color":16777215,"reflectivity":1,"refractionRatio":0.98,"side":2,"opacity":0.07,"transparent":true,"blendColor":0,"depthWrite":false},{"uuid":"4bb1412a-79f7-4fc9-bd8b-d3c547d7243f","type":"LineBasicMaterial","color":16777215,"opacity":0.8,"transparent":true,"blendColor":0},{"uuid":"a88303e1-1932-47cd-8d92-10b14a605130","type":"MeshStandardMaterial","color":15922424,"roughness":0.4,"metalness":0.2,"emissive":0,"envMapIntensity":1,"blendColor":0},{"uuid":"cfdbf797-c7c7-447e-90c2-7dfe81aaa69b","type":"MeshStandardMaterial","color":3824192,"roughness":0.55,"metalness":0.08,"emissive":0,"envMapIntensity":1,"blendColor":0},{"uuid":"993fd5f6-c3cc-4249-934e-2414ed3c6768","type":"MeshStandardMaterial","color":8947882,"roughness":0.55,"metalness":0.08,"emissive":0,"envMapIntensity":1,"opacity":0.4,"transparent":true,"blendColor":0},{"uuid":"52f61012-fc4e-4137-b95c-cb8fb3e93dd7","type":"MeshStandardMaterial","color":16747546,"roughness":0.55,"metalness":0.08,"emissive":5910016,"envMapIntensity":1,"blendColor":0},{"uuid":"16267f4e-cf78-4146-afa7-41dccc41502e","type":"MeshStandardMaterial","color":2792948,"roughness":0.55,"metalness":0.08,"emissive":404042,"envMapIntensity":1,"blendColor":0},{"uuid":"3fec5d4c-0e16-4caa-a426-9d7e2025a1cb","type":"MeshStandardMaterial","color":3724907,"roughness":0.55,"metalness":0.08,"emissive":408090,"envMapIntensity":1,"blendColor":0},{"uuid":"8b10c20d-f2a4-45ac-952b-3ed20f9a5b81","type":"MeshStandardMaterial","color":16765567,"roughness":0